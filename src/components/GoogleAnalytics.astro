---
interface Props {
  id: string;
}

const { id } = Astro.props;

if (import.meta.env.DEV) {
  return null;
}

const gtagUrl = `https://www.googletagmanager.com/gtag/js?id=${id}`;
const scriptContent = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${id}');
`;
---

<>
  <script src={gtagUrl} async type="text/partytown"></script>
  <script type="text/partytown" set:html={scriptContent} />
</>
