---
interface Props {
  link?: string;
}

const { link } = Astro.props;
---

{
  link ? (
    <a href={link} class="inline-block">
      <span class="inline-flex items-center rounded-md bg-white/80 px-2 py-1 text-xs font-medium text-gray-600 inset-ring inset-ring-gray-500/10 dark:bg-gray-800/80 dark:text-gray-300">
        <slot />
      </span>
    </a>
  ) : (
    <span class="inline-flex items-center rounded-md bg-white/80 px-2 py-1 text-xs font-medium text-gray-600 inset-ring inset-ring-gray-500/10 dark:bg-gray-800/80 dark:text-gray-300">
      <slot />
    </span>
  )
}
